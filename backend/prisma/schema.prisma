// ==========================================
// PRISMA SCHEMA FOR LMS BACKEND
// Tech Stack: PostgreSQL (Neon DB), Prisma ORM
// ==========================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  SUSPENDED
}

enum CohortStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum ResourceType {
  PDF
  ZIP_CODE
  EXTERNAL_LINK
  VIDEO_RECORDING
  FIGMA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  COURSE_ENROLLMENT
  COHORT_ENROLLMENT
  SUBSCRIPTION
}

// ------------------------------------------
// USER & AUTHENTICATION (WITH DEVICE LIMITS)
// ------------------------------------------
model User {
  id              String                @id @default(uuid())
  email           String                @unique
  googleId        String?               @unique
  passwordHash    String?
  fullName        String
  avatarUrl       String?
  role            Role                  @default(STUDENT)
  isEmailVerified Boolean               @default(false)
  maxDevices      Int                   @default(1) // Configurable concurrent device limit
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Relations
  devices         UserDevice[]
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  activityLogs    ActivityLog[]
  createdCourses  Course[]              @relation("InstructorCourses")
  roadmapUsers    UserRoadmapProgress[]
  cohortInstructor Cohort[]            @relation("CohortInstructor")
  cohortEnrollments CohortEnrollment[]  @relation("CohortEnrollments")
  payments        Payment[]
  onboarding      UserOnboarding?
  assignmentSubmissions AssignmentSubmission[]

  @@index([email])
  @@index([googleId])
  @@index([role])
}

model UserOnboarding {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  educationStatus String?   // "1st_year" | "2nd_year" | "3rd_year" | "4th_year" | "working_professional"
  targetDomain    String?   // Step 2
  experienceLevel String?   // Step 3
  primaryGoal     String?   // Step 4
  completedStep   Int       @default(1)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([educationStatus])
}

model UserDevice {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String   // Client Fingerprint / Unique Hardware Identifier
  deviceName   String   // e.g. "Chrome 120 on macOS"
  ipAddress    String
  userAgent    String
  sessionToken String   @unique
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([sessionToken])
}

// ------------------------------------------
// CONTENT CMS & COURSE STRUCTURE
// ------------------------------------------
model Course {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  subtitle      String?
  description   String        @db.Text
  coverImageUrl String?
  price         Decimal       @default(0.00) @db.Decimal(10, 2)
  status        CourseStatus  @default(DRAFT)
  level         CourseLevel   @default(BEGINNER)
  instructorId  String
  instructor    User          @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  modules       Module[]
  enrollments   Enrollment[]
  resources     Resource[]
  roadmapItems  RoadmapItem[]
  cohorts       Cohort[]
  payments      Payment[]
  assignments   Assignment[]

  @@index([slug])
  @@index([status, level])
  @@index([instructorId])
}

model Cohort {
  id           String       @id @default(uuid())
  courseId     String
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name         String
  description  String?      @db.Text
  startDate    DateTime
  endDate      DateTime
  instructorId String
  instructor   User         @relation("CohortInstructor", fields: [instructorId], references: [id])
  maxStudents  Int          @default(50)
  currentStudents Int       @default(0)
  status       CohortStatus @default(UPCOMING)
  imageUrl     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  enrollments  CohortEnrollment[]
  payments      Payment[]

  @@index([courseId])
  @@index([instructorId])
  @@index([status, startDate])
}

model CohortEnrollment {
  id        String   @id @default(uuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("CohortEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  completedAt DateTime?

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  position    Int      @default(1) // Sorting order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lessons     Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id              String       @id @default(uuid())
  moduleId        String
  module          Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  type            LessonType   @default(VIDEO)
  content         String?      @db.Text // Markdown text / article body
  videoUrl        String?      // Cloudflare Stream / Vimeo / S3 HLS URL
  durationSeconds Int          @default(0)
  isFreePreview   Boolean      @default(false)
  position        Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  progress        LessonProgress[]
  resources       Resource[]

  @@unique([moduleId, slug])
  @@index([moduleId, position])
}

// ------------------------------------------
// ENROLLMENTS & CHECKLIST PROGRESS
// ------------------------------------------
model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  progressPct Float            @default(0.0) // 0.0 to 100.0%
  enrolledAt  DateTime         @default(now())
  expiresAt   DateTime?
  completedAt DateTime?

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId])
}

model LessonProgress {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId         String
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted      Boolean   @default(false)
  watchTimeSeconds Int       @default(0)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, isCompleted])
  @@index([lessonId])
}

// ------------------------------------------
// RESOURCES & REFERENCES
// ------------------------------------------
model Resource {
  id          String       @id @default(uuid())
  title       String
  description String?
  url         String
  type        ResourceType @default(EXTERNAL_LINK)
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())

  @@index([courseId])
  @@index([lessonId])
}

// ------------------------------------------
// LEARNING ROADMAPS
// ------------------------------------------
model Roadmap {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  iconUrl     String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items        RoadmapItem[]
  userProgress UserRoadmapProgress[]

  @@index([slug])
}

model RoadmapItem {
  id         String   @id @default(uuid())
  roadmapId  String
  roadmap    Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stepOrder  Int      // Sequential order in roadmap path
  isRequired Boolean  @default(true)

  @@unique([roadmapId, courseId])
  @@index([roadmapId, stepOrder])
}

model UserRoadmapProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  progressPct Float    @default(0.0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, roadmapId])
}

// ------------------------------------------
// AUDIT LOGS & STUDENT ACTIVITY
// ------------------------------------------
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "AUTH_LOGIN", "LESSON_COMPLETED", "DEVICE_REVOKED"
  metadata  Json?    // IP, user agent, lesson details
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
}

// ------------------------------------------
// PAYMENTS & TRANSACTIONS
// ------------------------------------------
model Payment {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  razorpayOrderId String        @unique
  razorpayPaymentId String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  type            PaymentType
  courseId        String?
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  cohortId        String?
  cohort          Cohort?       @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  metadata        Json?         // Additional payment details
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([status])
}

// ------------------------------------------
// ASSIGNMENTS & SUBMISSIONS
// ------------------------------------------
model Assignment {
  id              String                @id @default(uuid())
  title           String
  description     String?               @db.Text
  instructions    String?               @db.Text
  courseId        String?
  course          Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseName      String?
  module          String?
  topic           String?
  difficulty      String?               @default("Medium")
  problemsCount   Int                   @default(0)
  problemsList    Json?
  releaseDate     String?
  startTime       String?
  deadline        String?
  deadlineTime    String?
  dueDate         DateTime?
  dueDateString   String?
  allowLate       Boolean               @default(false)
  latePenalty     String?
  resources       Json?
  submissionTypes Json?
  maxFileSize     String?
  maxAttempts     String?
  totalMarks      Int                   @default(100)
  passingMarks    Int                   @default(50)
  gradingMode     String?               @default("Manual Review")
  targetCohort    String?
  status          String                @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "SCHEDULED"
  notifyStudents  Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  submissions     AssignmentSubmission[]

  @@index([courseId])
  @@index([status])
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?    @db.Text
  fileUrl      String?
  githubUrl    String?
  status       String     @default("PENDING") // "PENDING" | "GRADED" | "NEEDS_REVIEW"
  score        Int?
  maxScore     Int        @default(100)
  feedback     String?    @db.Text
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assignmentId])
  @@index([userId])
}

// ------------------------------------------
// PRACTICE PROBLEMS
// ------------------------------------------
model PracticeProblem {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  category           String   @default("Arrays")
  difficulty         String   @default("Medium") // "Easy" | "Medium" | "Hard"
  acceptance         String   @default("75.0%")
  submissions        Int      @default(0)
  testCases          Int      @default(10)
  status             String   @default("Live") // "Live" | "Draft"
  description        String?  @db.Text
  sampleInput        String?  @db.Text
  sampleOutput       String?  @db.Text
  constraints        String?  @db.Text
  hints              Json?    // array of strings
  starterCode        Json?    // { javascript: "...", python: "...", cpp: "..." }
  tags               Json?    // array of strings
  companies          String?
  examples           Json?    // array of { id, input, output, explanation }
  editorialApproach  String?  @db.Text
  editorialAlgorithm String?  @db.Text
  timeComplexity     String?
  spaceComplexity    String?
  testCasesList      Json?    // array of { id, input, expectedOutput }
  referenceSolution  Json?    // { javascript: "...", python: "...", cpp: "..." }
  estimatedSolveTime String?
  visibility         String?  @default("Public")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([difficulty])
  @@index([status])
}

// ------------------------------------------
// LIVE SESSIONS & WEBINARS
// ------------------------------------------
model LiveSession {
  id                   String   @id @default(uuid())
  title                String
  instructor           String   @default("Platform Admin")
  sessionType          String   @default("Live Class") // "Live Class" | "Office Hours" | "Doubt Clearing" | "Webinar"
  description          String?  @db.Text
  courseId             String?
  course               String?  // course title or name
  module               String?
  topic                String?
  targetCohort         String?  @default("All Enrolled Students")
  date                 String   // e.g. "2026-09-24"
  timezone             String   @default("IST (UTC+5:30) - Asia/Kolkata")
  startTime            String   // e.g. "18:00"
  endTime              String   // e.g. "19:30"
  platform             String   @default("Google Meet") // "Google Meet" | "Zoom" | "Microsoft Teams" | "In-App Live Stream"
  meetingLink          String?
  passcode             String?
  hostNotes            String?  @db.Text
  resources            Json?    // array of { id, name, size, url }
  emailReminders       Boolean  @default(true)
  inAppNotifications   Boolean  @default(true)
  reminderSchedule     String?  @default("30 minutes before")
  autoRecord           Boolean  @default(true)
  uploadRecording      Boolean  @default(true)
  aiNotes              Boolean  @default(true)
  autoPublishRecording Boolean  @default(false)
  trackAttendance      Boolean  @default(true)
  attendanceMethod     String?  @default("Automatic on join (min 15 mins)")
  attendanceThreshold  String?  @default("75%")
  maxAttendees         String?  @default("250")
  visibility           String?  @default("All enrolled students")
  status               String   @default("Scheduled") // "Scheduled" | "Live" | "Completed" | "Draft"
  attendees            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([course])
  @@index([date])
}
